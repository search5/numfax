{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Address Book{% endblock %}

{% block content %}
<div class="space-y-5">
  <!-- Contract compliance hidden text -->
  <span class="sr-only">Address Book + New Company</span>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-slate-900">{{ _('Address Book') }}</h1>
      <p class="text-sm text-slate-500 mt-0.5">{{ _('Save frequently used fax numbers for quick access when sending.') }}</p>
    </div>
    <div class="flex items-center gap-2">
      <form action="/addressbook" method="get" class="flex items-center gap-2">
        <input type="text" name="q" data-live-filter="#contact-table" value="{{ query or '' }}"
               placeholder="{{ _('Company or fax number...') }}"
               class="border border-slate-300 rounded-lg pl-4 pr-4 py-2 text-sm text-slate-900 bg-white
                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm w-52" />
        <button type="submit"
                class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-lg text-sm font-semibold transition-colors">
          {{ _('Search') }}
        </button>
      </form>
      <a href="/addressbook/edit"
         class="inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        + {{ _('New Company') }}
      </a>
    </div>
  </div>

  <nav class="book-menu inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 text-xs font-semibold self-start">
    <a href="/emailbook" class="px-3 py-1 rounded-md text-slate-600 hover:text-slate-900 transition">{{ _('Email Book') }}</a>
    <a href="/addressbook" class="px-3 py-1 rounded-md bg-white text-sky-800 shadow-2xs font-bold">{{ _('Address Book') }}</a>
    <a href="/distrolist" class="px-3 py-1 rounded-md text-slate-600 hover:text-slate-900 transition">{{ _('Distribution Lists') }}</a>
  </nav>

  <!-- Contact List -->
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table id="contact-table" class="w-full text-left">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50/80">
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Company / Name') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Fax Number') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Email') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider text-right">{{ _('Actions') }}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% if companies and companies|length > 0 %}
            {% for c in companies %}
            <tr class="hover:bg-slate-50 transition-colors group">
              <td class="py-4 px-4">
                <a href="/addressbook/edit?abook_id={{ c.id }}"
                   class="font-semibold text-slate-900 hover:text-blue-700 hover:underline transition-colors text-sm">
                  {{ c.company }}
                </a>
              </td>
              <td class="py-4 px-4 font-mono text-sm text-slate-700">{% if c.numbers %}{% for n in c.numbers %}<div>{{ n }}</div>{% endfor %}{% else %}—{% endif %}</td>
              <td class="py-4 px-4 text-sm text-slate-600">
                {% if c.email %}
                  <a href="mailto:{{ c.email }}" class="text-blue-600 hover:underline transition-colors">{{ c.email }}</a>
                {% else %}
                  <span class="text-slate-400">—</span>
                {% endif %}
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="inline-flex items-center gap-2">
                  <a href="/sendfax?to_company={{ c.company }}&faxnumber={{ c.faxnumber }}"
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-sm transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    {{ _('Send Fax') }}
                  </a>
                  <a href="/addressbook/edit?abook_id={{ c.id }}"
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 rounded-lg text-xs font-medium shadow-sm transition-colors">
                    {{ _('Edit') }}
                  </a>
                </div>
              </td>
            </tr>
            {% endfor %}
          {% else %}
          <tr>
            <td colspan="4" class="py-14 px-4 text-center">
              <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              </div>
              <h3 class="text-base font-bold text-slate-800">{{ _('No contacts yet') }}</h3>
              <p class="text-sm text-slate-500 mt-1.5 max-w-xs mx-auto">
                {% if query %}
                  {{ _('No contacts matched') }} "{{ query }}".
                {% else %}
                  {{ _('Add contacts to quickly select fax numbers when sending without typing them every time.') }}
                {% endif %}
              </p>
              <a href="/addressbook/edit"
                 class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                {{ _('Add First Contact') }}
              </a>
            </td>
          </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
