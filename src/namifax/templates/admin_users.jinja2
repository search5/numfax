{% extends "admin_layout.jinja2" %}

{% block title %}- NamiFAX - Admin - Users{% endblock %}

{% block content %}
<div class="space-y-6">
  
  <!-- Header & Actions -->
  <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-950 border border-sky-800 flex items-center justify-center text-sky-400 shadow-inner">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-white tracking-tight">{{ _('User Accounts') }}</h2>
        <p class="text-xs text-slate-400">{{ _('Manage system operator credentials, access permissions, and route mapping') }}</p>
      </div>
    </div>

    <a href="#user-form" class="inline-flex items-center space-x-1.5 px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold shadow-2xs transition">
      <span>+ {{ _('Create New User') }}</span>
    </a>
  </div>

  <!-- Users Table (Dark Appliance Data Grid) -->
  <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left border-collapse">
        <thead>
          <tr class="bg-slate-900 border-b border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
            <th scope="col" class="py-3 px-4">{{ _('Username') }}</th>
            <th scope="col" class="py-3 px-4">{{ _('Name') }}</th>
            <th scope="col" class="py-3 px-4">{{ _('Email') }}</th>
            <th scope="col" class="py-3 px-3 text-center">{{ _('Superuser') }}</th>
            <th scope="col" class="py-3 px-3 text-center">{{ _('Admin') }}</th>
            <th scope="col" class="py-3 px-4 text-right">{{ _('Actions') }}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-slate-300">
          {% for u in users %}
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-3 px-4 font-mono font-bold text-white">
                <a href="/admin/users?uid={{ u.uid }}" class="hover:text-sky-400 hover:underline transition">{{ u.username }}</a>
              </td>
              <td class="py-3 px-4 text-slate-300 font-medium">{{ u.name }}</td>
              <td class="py-3 px-4 font-mono text-sky-400">
                <a href="mailto:{{ u.email }}" class="hover:underline">{{ u.email }}</a>
              </td>
              <td class="py-3 px-3 text-center">
                {% if u.superuser %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-800">{{ _('YES') }}</span>
                {% else %}
                  <span class="text-slate-600 font-mono text-[11px]">{{ _('NO') }}</span>
                {% endif %}
              </td>
              <td class="py-3 px-3 text-center">
                {% if u.is_admin %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-sky-950 text-sky-300 border border-sky-800">{{ _('YES') }}</span>
                {% else %}
                  <span class="text-slate-600 font-mono text-[11px]">{{ _('NO') }}</span>
                {% endif %}
              </td>
              <td class="py-3 px-4 text-right whitespace-nowrap">
                <a href="/admin/users?uid={{ u.uid }}" class="inline-flex items-center px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-sky-400 rounded-lg text-xs font-semibold border border-slate-700 transition">
                  {{ _('Edit') }}
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- User Creation / Edit Form (Full Legacy Fidelity & Exact Contract Sequence) -->
  <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl p-6 shadow-xs space-y-5" id="user-form">
    <div class="border-b border-slate-800 pb-3 flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <h3 class="text-xs font-bold text-white uppercase tracking-wider">
        {% if selected_user and selected_user.uid %}{{ _('Configure User:') }} {{ selected_user.username }}{% else %}{{ _('Create New User') }}{% endif %}
      </h3>
    </div>

    <form action="/admin/users" method="post" class="space-y-5 text-xs">
      
      <!-- Primary Credentials -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Full Name') }} *</label>
          <input type="text" name="name" id="name" value="{{ selected_user.name or '' }}" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>
        <div>
          <label for="username" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Username') }} *</label>
          <input type="text" name="username" id="username" value="{{ selected_user.username or '' }}" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="password" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Password') }}</label>
          <input type="password" name="password" id="password" placeholder="{% if selected_user.username %}Leave empty to keep current{% else %}Required for new user{% endif %}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>
        <div>
          <label for="email" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Email Address') }} *</label>
          <input type="email" name="email" id="email" value="{{ selected_user.email or '' }}" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>
      </div>

      <!-- Permission Checkboxes (Sequence: is_admin, superuser, can_del, any_modem) -->
      <div class="pt-3 border-t border-slate-800">
        <span class="block font-bold text-slate-400 uppercase text-[11px] tracking-wider mb-2.5">{{ _('Permissions & Capabilities') }}</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <label class="flex items-center space-x-2.5 p-3 rounded-lg bg-slate-900 border border-slate-800 cursor-pointer hover:border-slate-700 transition">
            <input type="checkbox" name="is_admin" value="1" {% if selected_user.is_admin %}checked{% endif %} class="rounded border-slate-700 bg-slate-800 text-sky-600 focus:ring-sky-500 w-4 h-4" />
            <span class="font-medium text-slate-200">{{ _('Administrator Console') }}</span>
          </label>
          <label class="flex items-center space-x-2.5 p-3 rounded-lg bg-slate-900 border border-slate-800 cursor-pointer hover:border-slate-700 transition">
            <input type="checkbox" name="superuser" value="1" {% if selected_user.superuser %}checked{% endif %} class="rounded border-slate-700 bg-slate-800 text-sky-600 focus:ring-sky-500 w-4 h-4" />
            <span class="font-medium text-slate-200">{{ _('Superuser Rights') }}</span>
          </label>
          <label class="flex items-center space-x-2.5 p-3 rounded-lg bg-slate-900 border border-slate-800 cursor-pointer hover:border-slate-700 transition">
            <input type="checkbox" name="can_del" value="1" {% if selected_user.can_del %}checked{% endif %} class="rounded border-slate-700 bg-slate-800 text-sky-600 focus:ring-sky-500 w-4 h-4" />
            <span class="font-medium text-slate-200">{{ _('Can Delete Faxes') }}</span>
          </label>
          <label class="flex items-center space-x-2.5 p-3 rounded-lg bg-slate-900 border border-slate-800 cursor-pointer hover:border-slate-700 transition">
            <input type="checkbox" name="any_modem" value="1" {% if selected_user.any_modem %}checked{% endif %} class="rounded border-slate-700 bg-slate-800 text-sky-600 focus:ring-sky-500 w-4 h-4" />
            <span class="font-medium text-slate-200">{{ _('Send on Any Modem') }}</span>
          </label>
        </div>
      </div>

      <!-- 3 Fieldsets: DID Routes, Modem Lines, Categories -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-3 border-t border-slate-800">
        
        <!-- DID Routes -->
        <fieldset class="border border-slate-800 rounded-xl p-4 bg-slate-900">
          <legend class="px-2 font-bold text-slate-300 text-[11px] uppercase tracking-wider">{{ _('DID Routes') }}</legend>
          <div class="space-y-2 max-h-44 overflow-y-auto pt-1">
            {% for route in did_routes %}
              <label class="flex items-center space-x-2.5 cursor-pointer text-slate-300 hover:text-white">
                <input type="checkbox" name="didrouting[]" value="{{ route.didr_id }}" checked class="rounded border-slate-700 bg-slate-800 text-sky-600 w-3.5 h-3.5" />
                <span class="font-mono text-xs">{{ route.route }} - {{ route.alias }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <!-- Fax Lines (Modems) -->
        <fieldset class="border border-slate-800 rounded-xl p-4 bg-slate-900">
          <legend class="px-2 font-bold text-slate-300 text-[11px] uppercase tracking-wider">{{ _('Fax Lines') }}</legend>
          <div class="space-y-2 max-h-44 overflow-y-auto pt-1">
            {% for modem in modem_devices %}
              <label class="flex items-center space-x-2.5 cursor-pointer text-slate-300 hover:text-white">
                <input type="checkbox" name="modemdevs[]" value="{{ modem.device }}" checked class="rounded border-slate-700 bg-slate-800 text-sky-600 w-3.5 h-3.5" />
                <span class="font-mono text-xs">{{ modem.device }} ({{ modem.alias }})</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <!-- Categories -->
        <fieldset class="border border-slate-800 rounded-xl p-4 bg-slate-900">
          <legend class="px-2 font-bold text-slate-300 text-[11px] uppercase tracking-wider">{{ _('Categories') }}</legend>
          <div class="space-y-2 max-h-44 overflow-y-auto pt-1">
            {% for cat in categories %}
              <label class="flex items-center space-x-2.5 cursor-pointer text-slate-300 hover:text-white">
                <input type="checkbox" name="faxcats[]" value="{{ cat.catid }}" checked class="rounded border-slate-700 bg-slate-800 text-sky-600 w-3.5 h-3.5" />
                <span class="text-xs">{{ cat.name }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

      </div>

      {% if selected_user and selected_user.uid %}
        <input type="hidden" name="uid" value="{{ selected_user.uid }}" />
      {% endif %}
      <input type="hidden" name="_submit_check" value="1" />

      <!-- Submit / Cancel -->
      <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
        {% if selected_user and selected_user.uid %}
          <button type="submit" name="delete" value="1" class="px-4 py-2 bg-rose-900 hover:bg-rose-800 text-white rounded-lg font-bold text-xs transition" onclick="return confirm('Are you sure you want to delete this user?');">{{ _('Delete') }}</button>
          <div class="space-x-3">
            <a href="/admin/users" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg font-semibold text-xs transition">{{ _('Cancel') }}</a>
            <button type="submit" name="save" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">
              {{ _('Save') }}
            </button>
          </div>
        {% else %}
          <div></div>
          <div class="space-x-3">
            <a href="/admin/users" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg font-semibold text-xs transition">{{ _('Cancel') }}</a>
            <button type="submit" name="create" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">
              {{ _('Save') }}
            </button>
          </div>
        {% endif %}
      </div>

    </form>
  </div>

</div>
{% endblock %}
