<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}NamiFAX{% endblock %}</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.4.0" type="text/css" />
  <style>
    .strorange { color: #c2410c; font-weight: 600; }
    .modem-status-idle { color: #15803d; font-weight: 600; }
    .modem-status-busy { color: #b45309; font-weight: 600; }
    .modem-status-down { color: #b91c1c; font-weight: 600; }
  </style>
  {% block extra_head %}{% endblock %}
</head>
<body class="min-h-full flex flex-col text-slate-900 font-sans antialiased bg-slate-50 selection:bg-blue-100 selection:text-blue-900">

  {% if current_user %}
  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Brand -->
        <div class="flex items-center">
          <a href="/" title="NamiFAX Home" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center text-white shadow-sm group-hover:bg-blue-700 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-sm font-bold text-slate-900 leading-tight">NamiFAX</div>
              <div class="text-[11px] text-slate-500 leading-tight">Enterprise Fax System</div>
            </div>
          </a>
        </div>

        <!-- Main Navigation -->
        <nav class="hidden md:flex items-center gap-1">
          <a href="/inbox" accesskey="i"
             class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors
                    {% if active_tab == 'inbox' %}bg-blue-50 text-blue-700{% else %}text-slate-600 hover:text-slate-900 hover:bg-slate-100{% endif %}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            <span>Inbox</span>
            {% if num_inbox %}
              <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-blue-600 text-white">{{ num_inbox }}</span>
            {% endif %}
          </a>

          <a href="/sendfax" accesskey="s"
             class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors
                    {% if active_tab == 'sendfax' %}bg-blue-50 text-blue-700{% else %}text-slate-600 hover:text-slate-900 hover:bg-slate-100{% endif %}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            <span>Send Fax</span>
          </a>

          <a href="/archive" accesskey="a"
             class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors
                    {% if active_tab == 'archive' %}bg-blue-50 text-blue-700{% else %}text-slate-600 hover:text-slate-900 hover:bg-slate-100{% endif %}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
            </svg>
            <span>Archive</span>
          </a>

          <a href="/outbox" accesskey="o"
             class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors
                    {% if active_tab == 'outbox' %}bg-blue-50 text-blue-700{% else %}text-slate-600 hover:text-slate-900 hover:bg-slate-100{% endif %}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
            <span>Outbox</span>
            {% if num_outbox %}
              <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-500 text-white">{{ num_outbox }}</span>
            {% endif %}
          </a>

          <a href="/addressbook" accesskey="c"
             class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors
                    {% if active_tab == 'contacts' %}bg-blue-50 text-blue-700{% else %}text-slate-600 hover:text-slate-900 hover:bg-slate-100{% endif %}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <span>Contacts</span>
          </a>
        </nav>

        <!-- Right: User Menu -->
        <div class="flex items-center gap-3">
          <!-- Modem Status Pill -->
          {% if modem_list %}
            <div class="hidden lg:flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-full text-xs text-emerald-700 font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>{{ modem_list|length }} Line{{ 's' if modem_list|length > 1 else '' }} Ready</span>
            </div>
          {% else %}
            <div class="hidden lg:flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-full text-xs text-emerald-700 font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Engine Ready</span>
            </div>
          {% endif %}

          <!-- Admin Link -->
          {% if current_user.is_admin %}
            <a href="/admin" title="Admin Panel"
               class="flex items-center gap-1.5 px-3 py-1.5 text-sm text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>Admin</span>
            </a>
          {% endif %}

          <!-- User Dropdown -->
          <div class="flex items-center gap-2 pl-3 border-l border-slate-200">
            <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold uppercase">
              {{ current_user.username[0] }}
            </div>
            <div class="hidden sm:block text-left">
              <div class="text-sm font-semibold text-slate-900 leading-tight">{{ current_user.username }}</div>
              <div class="text-xs text-slate-500 leading-tight flex items-center gap-2">
                <a href="/settings" class="hover:text-blue-600 transition-colors">Settings</a>
                <span class="text-slate-300">·</span>
                <a href="/logout" class="hover:text-red-600 transition-colors">Logout</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Active Tab Indicator -->
    {% if active_tab %}
    <div class="h-0.5 bg-slate-100">
      <div class="h-full bg-blue-600 transition-all"
           style="margin-left: {% if active_tab == 'inbox' %}0{% elif active_tab == 'sendfax' %}20%{% elif active_tab == 'archive' %}40%{% elif active_tab == 'outbox' %}60%{% elif active_tab == 'contacts' %}80%{% else %}0{% endif %}; width: 20%;"></div>
    </div>
    {% endif %}
  </header>

  <!-- Modem Status Bar (collapsible, subtle) -->
  {% if modem_list %}
  <div class="bg-slate-800 border-b border-slate-700 text-white py-2 text-xs" id="modem-status-div">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-4 flex-wrap">
      <div class="flex items-center gap-1.5 text-slate-400">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="font-medium uppercase tracking-wide text-[10px]">HylaFAX Modems</span>
      </div>
      {% for m in modem_list %}
        <div class="flex items-center gap-1.5">
          <span class="text-slate-400">{{ m.alias or m.device }}:</span>
          <span class="font-mono font-semibold px-2 py-0.5 rounded text-[11px]
                {% if m.status == 'IDLE' or not m.status %}text-emerald-400
                {% elif m.status == 'SENDING' %}text-amber-400
                {% else %}text-rose-400{% endif %}">
            {{ m.status or 'IDLE' }}
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% endif %}

  <!-- Main Content -->
  <main class="flex-grow max-w-screen-xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {% if error %}
      <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <p class="font-semibold">Error</p>
          <p class="text-red-700 text-sm mt-0.5">{{ error }}</p>
        </div>
      </div>
    {% endif %}

    {% if flash_message %}
      <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm flex items-center gap-3">
        <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>{{ flash_message }}</span>
      </div>
    {% endif %}

    {% block content %}{% endblock %}
  </main>

  <!-- Footer -->
  <footer class="mt-auto border-t border-slate-200 bg-white py-5">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-sm text-slate-600">
        <span class="font-semibold text-slate-900">NamiFAX</span>
        <span class="text-slate-300">·</span>
        <span>On-Premise Facsimile Appliance</span>
      </div>
      <p class="text-xs text-slate-400">
        Enterprise Edition 3.3.5 &copy; 2005–2008 iFAX Solutions
      </p>
    </div>
  </footer>

  {% block extra_scripts %}{% endblock %}
</body>
</html>
