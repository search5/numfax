{% extends "layout.jinja2" %}

{% block title %}- NamiFAX - Settings{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">
  
  <!-- Header & Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">User Settings</h2>
        <p class="text-xs text-slate-500">Configure your personal profile, fax station identity, and portal preferences.</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-2">
      <a href="/inbox" class="px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold border border-slate-300 shadow-2xs transition">
        &larr; Return to Inbox
      </a>
    </div>
  </div>

  {% if message %}
    <div class="p-3.5 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-lg flex items-center space-x-2 shadow-2xs">
      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="font-medium">{{ message }}</span>
    </div>
  {% endif %}

  {% if error %}
    <div class="p-3.5 bg-rose-50 border border-rose-200 text-rose-800 text-xs rounded-lg flex items-center space-x-2 shadow-2xs">
      <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="font-medium">{{ error }}</span>
    </div>
  {% endif %}

  <!-- Strict Form Contract -->
  <form action="/settings" method="post" class="space-y-6 text-xs">
    
    <!-- Section 1: Personal & Contact Information -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Personal &amp; Organization Details</h3>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block font-semibold text-slate-700 text-xs mb-1.5">Full Name *</label>
          <input type="text" name="name" id="name" value="{{ user_profile.name or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
        </div>

        <div>
          <label for="email" class="block font-semibold text-slate-700 text-xs mb-1.5">Email Address *</label>
          <input type="email" name="email" id="email" value="{{ user_profile.email or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
        </div>

        <div>
          <label for="from_company" class="block font-semibold text-slate-700 text-xs mb-1.5">Company Name</label>
          <input type="text" name="from_company" id="from_company" value="{{ user_profile.from_company or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
        </div>

        <div>
          <label for="from_location" class="block font-semibold text-slate-700 text-xs mb-1.5">Office / Location</label>
          <input type="text" name="from_location" id="from_location" value="{{ user_profile.from_location or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
        </div>

        <div>
          <label for="from_voicenumber" class="block font-semibold text-slate-700 text-xs mb-1.5">Direct Voice Number</label>
          <input type="text" name="from_voicenumber" id="from_voicenumber" value="{{ user_profile.from_voicenumber or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
        </div>

        <div>
          <label for="from_faxnumber" class="block font-semibold text-slate-700 text-xs mb-1.5">Direct Fax Number</label>
          <input type="text" name="from_faxnumber" id="from_faxnumber" value="{{ user_profile.from_faxnumber or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
        </div>

        <div class="md:col-span-2">
          <label for="user_tsi" class="block font-semibold text-slate-700 text-xs mb-1.5">Transmitting Station ID (TSI)</label>
          <input type="text" name="user_tsi" id="user_tsi" value="{{ user_profile.user_tsi or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 font-mono bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="e.g. +1 555 123 4567" />
          <p class="text-[11px] text-slate-400 mt-1">Header identifier imprinted on top of transmitted fax pages.</p>
        </div>
      </div>

      <div>
        <label for="email_sig" class="block font-semibold text-slate-700 text-xs mb-1.5">Email &amp; Fax Notification Signature</label>
        <textarea name="email_sig" id="email_sig" rows="3" class="w-full border border-slate-300 rounded-lg p-3 bg-slate-50/50 text-slate-900 font-mono text-[11px] focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">{{ user_profile.email_sig or '' }}</textarea>
      </div>
    </div>

    <!-- Section 2: Application Preferences -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Portal &amp; Delivery Preferences</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="language" class="block font-semibold text-slate-700 text-xs mb-1.5">Display Language</label>
          <select name="language" id="language" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
            <option value="en" {% if user_profile.language == 'en' %}selected{% endif %}>English (US)</option>
            <option value="ko" {% if user_profile.language == 'ko' %}selected{% endif %}>Korean (한국어)</option>
            <option value="es" {% if user_profile.language == 'es' %}selected{% endif %}>Spanish (Español)</option>
          </select>
        </div>

        <div>
          <label for="coverpage_id" class="block font-semibold text-slate-700 text-xs mb-1.5">Default Cover Page</label>
          <select name="coverpage_id" id="coverpage_id" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
            <option value="standard" selected>standard</option>
            <option value="urgent">urgent</option>
          </select>
        </div>

        <div>
          <label for="faxperpageinbox" class="block font-semibold text-slate-700 text-xs mb-1.5">Faxes Per Page</label>
          <select name="faxperpageinbox" id="faxperpageinbox" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
            <option value="10">10 faxes</option>
            <option value="20" selected>20 faxes</option>
            <option value="50">50 faxes</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Section 3: Change Password -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Change Password</h3>
      </div>
      
      <div>
        <label for="old_password" class="block font-semibold text-slate-700 text-xs mb-1.5">Current Password</label>
        <input type="password" name="old_password" id="old_password" class="w-full md:w-80 border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="Enter current password to verify" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="new_password" class="block font-semibold text-slate-700 text-xs mb-1.5">New Password</label>
          <input type="password" name="new_password" id="new_password" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="Enter secure new password" />
        </div>
        <div>
          <label for="confirm_password" class="block font-semibold text-slate-700 text-xs mb-1.5">Confirm New Password</label>
          <input type="password" name="confirm_password" id="confirm_password" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="Re-type new password" />
        </div>
      </div>
    </div>

    <!-- Hidden Submit Check -->
    <input type="hidden" name="_submit_check" value="1" />

    <!-- Form Footer Actions -->
    <div class="pt-4 border-t border-slate-200 flex items-center justify-end space-x-3">
      <a href="/inbox" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">Cancel</a>
      <button type="submit" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">
        Update Settings
      </button>
    </div>

  </form>

</div>
{% endblock %}

