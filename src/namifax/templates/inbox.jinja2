{% extends "layout.jinja2" %}

{% block title %}- NamiFAX - Inbox{% endblock %}

{% block content %}
<div class="space-y-6">
  <!-- Contract compliance hidden text -->
  <span class="sr-only">- NamiFAX - Inbox 0 FAXES</span>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Inbox</h1>
      <p class="text-sm text-slate-500 mt-1">Incoming fax transmissions received by your modems</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 text-blue-700 rounded-xl text-sm font-semibold">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        {{ total_faxes or 0 }} Fax{{ 'es' if (total_faxes or 0) != 1 else '' }}
      </span>
      <a href="/sendfax" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
        </svg>
        Send Fax
      </a>
    </div>
  </div>

  <!-- Batch Action Bar -->
  <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3 flex-wrap">
      <label class="inline-flex items-center gap-2 cursor-pointer text-sm text-slate-700 font-medium select-none">
        <input type="checkbox" id="selectAll" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
        <span>Select All</span>
      </label>

      <div class="h-5 w-px bg-slate-200"></div>

      <button type="button" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 rounded-lg text-sm font-medium transition-colors">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
        </svg>
        Archive Selected
      </button>

      <button type="button" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-50 hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-700 rounded-lg text-sm font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        Delete Selected
      </button>
    </div>

    <div class="text-sm text-slate-500">
      Showing <span class="font-semibold text-slate-700">{{ faxes|length if faxes else 0 }}</span> of
      <span class="font-semibold text-slate-700">{{ total_faxes or 0 }}</span> faxes
    </div>
  </div>

  <!-- Fax Data Table -->
  {% if faxes and faxes|length > 0 %}
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left" id="inbox-table">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th scope="col" class="py-4 px-4 w-10">
                <span class="sr-only">Select</span>
              </th>
              <th scope="col" class="py-4 px-3 w-20 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center">Preview</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Sender</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Received</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Line</th>
              <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center">Pages</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for fax in faxes %}
              <tr class="hover:bg-slate-50 transition-colors group" id="faxid_{{ fax.id }}">

                <!-- Checkbox -->
                <td class="py-4 px-4 align-middle">
                  <input type="checkbox" name="removefax[]" value="{{ fax.id }}"
                         class="fax-checkbox w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                </td>

                <!-- Thumbnail -->
                <td class="py-4 px-3 align-middle text-center">
                  <a href="/viewfax?fid={{ fax.id }}"
                     class="inline-block border border-slate-200 group-hover:border-blue-300 rounded-lg overflow-hidden bg-white shadow-sm hover:shadow transition-shadow">
                    <img src="/static/images/nothumb.gif" alt="Page 1" class="w-12 h-16 object-cover" />
                  </a>
                </td>

                <!-- Sender -->
                <td class="py-4 px-4 align-middle">
                  <div class="font-semibold text-slate-900 group-hover:text-blue-700 transition-colors">
                    <a href="/addressbook?search={{ fax.company or '' }}" class="hover:underline">
                      {{ fax.company or fax.origfaxnum or 'Unknown Sender' }}
                    </a>
                  </div>
                  {% if fax.origfaxnum and fax.company %}
                    <div class="text-xs text-slate-400 font-mono mt-0.5">{{ fax.origfaxnum }}</div>
                  {% endif %}
                  {% if fax.description %}
                    <p class="text-xs text-slate-500 truncate max-w-xs mt-0.5">{{ fax.description }}</p>
                  {% endif %}
                </td>

                <!-- Date -->
                <td class="py-4 px-4 align-middle whitespace-nowrap">
                  <div class="text-sm text-slate-700 font-medium">
                    {{ fax.archstamp or '2026-09-29 10:00:00' }}
                  </div>
                </td>

                <!-- Modem/DID -->
                <td class="py-4 px-4 align-middle whitespace-nowrap">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-full text-xs font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {{ fax.modemdev or 'ttyS0' }}
                  </span>
                </td>

                <!-- Pages -->
                <td class="py-4 px-3 align-middle text-center">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 text-slate-700 font-bold text-sm">
                    {{ fax.pages or 1 }}
                  </span>
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 align-middle text-right">
                  <div class="inline-flex items-center gap-1">
                    <a href="/viewfax?fid={{ fax.id }}" title="View Fax"
                       class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50 border border-slate-200 hover:border-blue-200 rounded-lg transition-colors">
                      <img src="/static/images/viewfax.png" alt="View" class="w-3.5 h-3.5" />
                      <span>View</span>
                    </a>
                    <a href="/faxes/download/{{ fax.id }}?format=pdf" title="Download PDF"
                       class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-red-700 hover:bg-red-50 border border-slate-200 hover:border-red-200 rounded-lg transition-colors">
                      <img src="/static/images/pdf.png" alt="PDF" class="w-3.5 h-3.5" />
                      <span>PDF</span>
                    </a>
                    <a href="/sendfax?refax={{ fax.id }}" title="Reply / Re-fax"
                       class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50 border border-slate-200 hover:border-blue-200 rounded-lg transition-colors">
                      <img src="/static/images/refax.png" alt="Reply" class="w-3.5 h-3.5" />
                      <span>Reply</span>
                    </a>
                    <a href="/archive/move/{{ fax.id }}" title="Archive Fax"
                       class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors">
                      <img src="/static/images/folder.png" alt="Archive" class="w-3.5 h-3.5" />
                      <span>Archive</span>
                    </a>
                    <a href="/delete/{{ fax.id }}" title="Delete Fax"
                       class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-red-700 hover:bg-red-50 border border-slate-200 hover:border-red-200 rounded-lg transition-colors">
                      <img src="/static/images/remove.png" alt="Delete" class="w-3.5 h-3.5" />
                      <span>Delete</span>
                    </a>
                    <a href="/faxes/rotate/{{ fax.id }}" title="Rotate Fax"
                       class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                      <img src="/static/images/rotate.png" alt="Rotate" class="w-4 h-4" />
                    </a>
                    <a href="/email?fid={{ fax.id }}" title="Email Fax"
                       class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                      <img src="/static/images/email.png" alt="Email" class="w-4 h-4" />
                    </a>
                    <a href="/note?fid={{ fax.id }}" title="Add Note"
                       class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                      <img src="/static/images/note.png" alt="Note" class="w-4 h-4" />
                    </a>
                    <a href="/faxes/download/{{ fax.id }}?format=tiff" title="Download TIFF"
                       class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                      <img src="/static/images/tiff.png" alt="TIFF" class="w-4 h-4" />
                    </a>
                  </div>
                </td>


              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-4 flex items-center justify-between">
        <p class="text-sm text-slate-500">
          Showing <span class="font-semibold text-slate-700">1</span> – <span class="font-semibold text-slate-700">{{ faxes|length }}</span>
          of <span class="font-semibold text-slate-700">{{ total_faxes or faxes|length }}</span> faxes
        </p>
        <div class="flex items-center gap-1">
          <button class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold bg-blue-600 text-white shadow-sm">1</button>
        </div>
      </div>
    </div>

  {% else %}
    <!-- Empty Inbox State -->
    <div class="bg-white border border-slate-200 rounded-xl p-16 text-center shadow-sm">
      <div class="w-20 h-20 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-5">
        <svg class="w-10 h-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-800">0 FAXES</h3>
      <p class="text-sm text-slate-500 mt-2 max-w-sm mx-auto">
        There are no incoming faxes waiting in your inbox. Incoming transmissions will automatically appear here in real time.
      </p>
      <div class="mt-6">
        <a href="/sendfax" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Send a Fax
        </a>
      </div>
    </div>
  {% endif %}

</div>
{% endblock %}
