{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Archive{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Archive</h1>
      <p class="text-sm text-slate-500 mt-1">Search and retrieve historical fax transmission records</p>
    </div>
    {% if results %}
      <span class="inline-flex items-center px-4 py-2 bg-slate-100 border border-slate-200 text-slate-700 rounded-xl text-sm font-semibold">
        {{ results|length }} result{{ 's' if results|length != 1 else '' }} found
      </span>
    {% endif %}
  </div>

  <!-- Search Filter Form -->
  <form action="/archive" method="get" class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <h2 class="text-base font-semibold text-slate-900">Search Filters</h2>
      <p class="text-sm text-slate-500 mt-0.5">Filter by keyword, date range, category, or fax ID</p>
    </div>

    <div class="p-6 space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label for="search" class="block text-sm font-semibold text-slate-800 mb-1.5">Keywords</label>
          <input type="text" name="search" id="search" value="{{ search or '' }}"
                 placeholder="Company, number, notes..."
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
        </div>

        <div>
          <label for="category" class="block text-sm font-semibold text-slate-800 mb-1.5">Category</label>
          <select name="category" id="category"
                  class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 bg-white
                         focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">
            <option value="">All Categories</option>
            <option value="invoices" {% if category == 'invoices' %}selected{% endif %}>Invoices &amp; Orders</option>
            <option value="legal" {% if category == 'legal' %}selected{% endif %}>Legal &amp; Contracts</option>
          </select>
        </div>

        <div>
          <label for="date_from" class="block text-sm font-semibold text-slate-800 mb-1.5">Date From</label>
          <input type="text" name="date_from" id="date_from" value="{{ date_from or '' }}"
                 placeholder="YYYY-MM-DD"
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm font-mono text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
        </div>

        <div>
          <label for="date_to" class="block text-sm font-semibold text-slate-800 mb-1.5">Date To</label>
          <input type="text" name="date_to" id="date_to" value="{{ date_to or '' }}"
                 placeholder="YYYY-MM-DD"
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm font-mono text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-4 border-t border-slate-100 items-end">
        <div>
          <label for="sentrecvd" class="block text-sm font-semibold text-slate-800 mb-1.5">Direction</label>
          <select name="sentrecvd" id="sentrecvd"
                  class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 bg-white
                         focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">
            <option value="">Sent &amp; Received</option>
            <option value="inbox" {% if sentrecvd == 'inbox' %}selected{% endif %}>Received Only</option>
            <option value="sent" {% if sentrecvd == 'sent' %}selected{% endif %}>Sent Only</option>
          </select>
        </div>

        <div>
          <label for="faxid" class="block text-sm font-semibold text-slate-800 mb-1.5">Fax ID</label>
          <input type="text" name="faxid" id="faxid" value="{{ faxid or '' }}"
                 placeholder="e.g. 104"
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm font-mono text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
        </div>

        <div class="lg:col-span-2 flex items-end gap-3 justify-end">
          <a href="/archive"
             class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-colors">
            Reset
          </a>
          <button type="submit"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold shadow-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Search Archive
          </button>
        </div>
      </div>
    </div>
  </form>

  <!-- Search Results -->
  {% if search or faxid %}
    {% if results and results|length > 0 %}
      <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
          <h2 class="text-base font-semibold text-slate-900">Results for "{{ search or faxid }}"</h2>
          <span class="text-sm text-slate-500">{{ results|length }} match{{ 'es' if results|length != 1 else '' }}</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50">
                <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center w-12">#</th>
                <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Sender / Company</th>
                <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Description</th>
                <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center">Pages</th>
                <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center">Category</th>
                <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
                <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {% for r in results %}
                <tr class="hover:bg-slate-50 transition-colors group" id="faxid_{{ r.id }}">
                  <td class="py-4 px-4 text-center text-sm text-slate-400 font-mono font-semibold">{{ loop.index }}</td>
                  <td class="py-4 px-4">
                    <a href="/addressbook?search={{ r.company }}"
                       class="font-semibold text-slate-900 hover:text-blue-700 hover:underline transition-colors">
                      {{ r.company }}
                    </a>
                    {% if r.origfaxnum %}
                      <div class="text-xs text-slate-400 font-mono mt-0.5">{{ r.origfaxnum }}</div>
                    {% endif %}
                  </td>
                  <td class="py-4 px-4 text-sm text-slate-600 truncate max-w-xs">{{ r.description or '—' }}</td>
                  <td class="py-4 px-3 text-center">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 text-slate-700 font-bold text-sm">
                      {{ r.pages or 1 }}
                    </span>
                  </td>
                  <td class="py-4 px-3 text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-600">
                      {{ r.category or 'General' }}
                    </span>
                  </td>
                  <td class="py-4 px-4 text-sm text-slate-600 font-mono whitespace-nowrap">
                    {{ r.archstamp or r.date or '—' }}
                  </td>
                  <td class="py-4 px-4 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1">
                      <a href="/viewfax?fid={{ r.id }}" title="View Fax"
                         class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50 border border-slate-200 hover:border-blue-200 rounded-lg transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        View
                      </a>
                      <a href="/faxes/download/{{ r.id }}?format=pdf" title="Download PDF"
                         class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-red-700 hover:bg-red-50 border border-slate-200 hover:border-red-200 rounded-lg transition-colors">
                        PDF
                      </a>
                      <a href="/sendfax?refax={{ r.id }}" title="Re-fax"
                         class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50 border border-slate-200 hover:border-blue-200 rounded-lg transition-colors">
                        Resend
                      </a>
                      <a href="/txreport?fid={{ r.id }}" title="TX Report"
                         class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors">
                        Report
                      </a>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

    {% else %}
      <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
        <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-800">No results found</h3>
        <p class="text-sm text-slate-500 mt-1.5 max-w-xs mx-auto">Try broadening your search terms or adjusting the date range.</p>
        <a href="/archive" class="mt-4 inline-block text-sm text-blue-600 hover:underline font-medium">Clear search and try again</a>
      </div>
    {% endif %}

  {% else %}
    <!-- Default / Initial State -->
    <div class="bg-white border border-slate-200 rounded-xl p-16 text-center shadow-sm">
      <div class="w-20 h-20 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-5">
        <svg class="w-10 h-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-800">Search the Archive</h3>
      <p class="text-sm text-slate-500 mt-2 max-w-sm mx-auto">
        Use the filters above to find historical fax records by keyword, date range, category, or fax ID.
      </p>
    </div>
  {% endif %}

</div>
{% endblock %}
