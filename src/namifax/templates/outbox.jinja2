{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Outbox{% endblock %}

{% block content %}
<div class="space-y-5">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Outbox</h1>
      <p class="text-sm text-slate-500 mt-0.5">Faxes currently queued or being transmitted.</p>
    </div>
    <a href="/sendfax"
       class="inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
      </svg>
      Send Fax
    </a>
  </div>

  {% if flash_message %}
  <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm flex items-center gap-3">
    <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>
    <span>{{ flash_message }}</span>
  </div>
  {% endif %}

  <!-- Info banner -->
  <div class="flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800">
    <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <p>This page shows only faxes that are <strong>queued or in progress</strong>. Once delivered, they are removed from this list. Find completed records in the <a href="/archive" class="underline font-semibold">Archive</a>.</p>
  </div>

  {% if jobs and jobs|length > 0 %}
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/60">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        {{ jobs|length }} job{{ 's' if jobs|length != 1 else '' }} in progress
      </span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50/80">
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Job ID</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Destination</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Company</th>
            <th class="py-3 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Pages</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Status</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for j in jobs %}
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-4 font-mono text-sm font-bold text-slate-700">#{{ j.jobid or j.jid }}</td>
            <td class="py-4 px-4 font-mono text-sm font-semibold text-slate-900">{{ j.destination or j.dest or '—' }}</td>
            <td class="py-4 px-4 text-sm text-slate-600 truncate max-w-xs">{{ j.company or '—' }}</td>
            <td class="py-4 px-3 text-center">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 text-slate-700 font-bold text-sm">
                {{ j.pages or 1 }}
              </span>
            </td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-amber-50 border border-amber-200 text-amber-700 text-xs font-bold rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                {{ j.status or 'Queued' }}
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="/outbox?kill={{ j.jobid or j.jid }}"
                 onclick="return confirm('Cancel job #{{ j.jobid or j.jid }}?')"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-red-600 rounded-lg text-xs font-semibold transition-colors">
                Cancel
              </a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% else %}
  <!-- Empty State -->
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-12 text-center">
    <div class="w-16 h-16 bg-emerald-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <h3 class="text-base font-bold text-slate-800">No jobs in queue</h3>
    <p class="text-sm text-slate-500 mt-1.5 max-w-xs mx-auto">
      There are no faxes waiting to be sent. Send a fax to see its progress here.
    </p>
    <a href="/sendfax"
       class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
      </svg>
      Send a Fax
    </a>
  </div>
  {% endif %}

  {% if failed_jobs and failed_jobs|length > 0 %}
  <div class="bg-white border border-red-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-red-100 bg-red-50/50 flex items-center gap-2">
      <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <h2 class="text-sm font-semibold text-red-900">Failed Transmissions — {{ failed_jobs|length }}</h2>
      <p class="text-xs text-red-500 ml-1">Review the number or retry below.</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-red-100 bg-red-50/30">
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">Job ID</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">Destination</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">Reason</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-red-50">
          {% for fj in failed_jobs %}
          <tr class="hover:bg-red-50/20 transition-colors">
            <td class="py-3.5 px-4 font-mono font-bold text-slate-800 text-sm">#{{ fj.jobid }}</td>
            <td class="py-3.5 px-4 font-mono text-sm text-slate-700">{{ fj.destination }}</td>
            <td class="py-3.5 px-4 text-sm text-red-700 font-medium">{{ fj.status or 'Busy — max retries exceeded' }}</td>
            <td class="py-3.5 px-4 text-right">
              <a href="/sendfax?refax={{ fj.jobid }}"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-blue-50 border border-slate-200 hover:border-blue-200 text-blue-700 rounded-lg text-xs font-semibold transition-colors">
                Retry
              </a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}
