{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Outbox{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Outbox</h1>
      <p class="text-sm text-slate-500 mt-1">Outgoing fax jobs currently queued in the hardware spooler</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-amber-50 border border-amber-200 text-amber-700 rounded-xl text-sm font-semibold">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        {{ jobs|length if jobs else 0 }} Job{{ 's' if (jobs|length if jobs else 0) != 1 else '' }} Queued
      </span>
      <a href="/sendfax" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
        </svg>
        Send Fax
      </a>
    </div>
  </div>

  {% if flash_message %}
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span>{{ flash_message }}</span>
    </div>
  {% endif %}

  <!-- Active Queue -->
  {% if jobs and jobs|length > 0 %}
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Job ID</th>
              <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Priority</th>
              <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">User</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Destination</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Company</th>
              <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center">Pages</th>
              <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Dials</th>
              <th scope="col" class="py-4 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
              <th scope="col" class="py-4 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for j in jobs %}
              <tr class="hover:bg-amber-50/40 transition-colors">
                <td class="py-4 px-4 font-mono font-bold text-slate-900 whitespace-nowrap text-sm">#{{ j.jobid or j.jid }}</td>
                <td class="py-4 px-3 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-700">
                    {{ j.pri or 'Normal' }}
                  </span>
                </td>
                <td class="py-4 px-3 text-sm text-slate-700 font-medium whitespace-nowrap">{{ j.user or 'admin' }}</td>
                <td class="py-4 px-4 font-mono text-sm font-semibold text-slate-800 whitespace-nowrap">{{ j.destination or j.dest or '' }}</td>
                <td class="py-4 px-4 text-sm text-slate-600 truncate max-w-xs">{{ j.company or '—' }}</td>
                <td class="py-4 px-3 text-center">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 text-slate-700 font-bold text-sm">
                    {{ j.pages or 1 }}
                  </span>
                </td>
                <td class="py-4 px-3 font-mono text-sm text-slate-600 whitespace-nowrap">{{ j.dials or '0:12' }}</td>
                <td class="py-4 px-3 whitespace-nowrap">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    {{ j.status or 'PENDING' }}
                  </span>
                </td>
                <td class="py-4 px-4 text-right whitespace-nowrap">
                  <a href="/outbox?kill={{ j.jobid or j.jid }}"
                     onclick="return confirm('Cancel job #{{ j.jobid or j.jid }}?')"
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-red-50 border border-slate-200 hover:border-red-300 text-red-600 hover:text-red-700 rounded-lg text-sm font-medium shadow-sm transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    Cancel
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  {% else %}
    <!-- Empty State -->
    <div class="bg-white border border-slate-200 rounded-xl p-16 text-center shadow-sm">
      <div class="w-20 h-20 bg-emerald-50 rounded-2xl flex items-center justify-center mx-auto mb-5">
        <svg class="w-10 h-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-800">No jobs in queue</h3>
      <p class="text-sm text-slate-500 mt-2 max-w-sm mx-auto">
        No outgoing faxes are waiting in the spooler. New transmissions will appear here when scheduled.
      </p>
      <div class="mt-6">
        <a href="/sendfax" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Send a Fax
        </a>
      </div>
    </div>
  {% endif %}

  <!-- Failed Jobs Section -->
  {% if failed_jobs and failed_jobs|length > 0 %}
    <div class="bg-white border border-red-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-red-100 bg-red-50/50 flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h2 class="text-base font-semibold text-red-900">Failed Transmissions</h2>
          <p class="text-xs text-red-600">{{ failed_jobs|length }} job{{ 's' if failed_jobs|length != 1 else '' }} failed</p>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-red-100 bg-red-50/30">
              <th scope="col" class="py-3.5 px-4 text-xs font-semibold text-red-700 uppercase tracking-wider">Job ID</th>
              <th scope="col" class="py-3.5 px-4 text-xs font-semibold text-red-700 uppercase tracking-wider">Destination</th>
              <th scope="col" class="py-3.5 px-4 text-xs font-semibold text-red-700 uppercase tracking-wider">Failure Reason</th>
              <th scope="col" class="py-3.5 px-4 text-xs font-semibold text-red-700 uppercase tracking-wider text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-red-50">
            {% for fj in failed_jobs %}
              <tr class="hover:bg-red-50/20 transition-colors">
                <td class="py-3.5 px-4 font-mono font-bold text-slate-900 text-sm">#{{ fj.jobid }}</td>
                <td class="py-3.5 px-4 font-mono text-sm text-slate-800">{{ fj.destination }}</td>
                <td class="py-3.5 px-4 text-sm text-red-700 font-medium">{{ fj.status or 'Failed — Busy signal' }}</td>
                <td class="py-3.5 px-4 text-right">
                  <a href="/sendfax?refax={{ fj.jobid }}"
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-blue-50 border border-slate-200 hover:border-blue-300 text-blue-700 rounded-lg text-sm font-medium shadow-sm transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    Retry
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

</div>
{% endblock %}
