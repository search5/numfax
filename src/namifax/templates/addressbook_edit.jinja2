{% extends "layout.jinja2" %}

{% block title %}NamiFAX - Address Book{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto space-y-6">
  
  <!-- Header & Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">
          {% if company and company.company %}{{ _('Edit Company') }} - {{ company.company }}{% else %}{{ _('Add New Company') }}{% endif %}
        </h2>
        <p class="text-xs text-slate-500">{{ _('Configure corporate contact identity and transmission routing defaults.') }}</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-2">
      <a href="/addressbook" class="px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold border border-slate-300 shadow-2xs transition">
        &larr; {{ _('Back to Contacts') }}
      </a>
    </div>
  </div>

  <form action="/addressbook/edit" method="post" class="space-y-6 text-xs">
    {% if company and (company.id or company.company_id) %}
      <input type="hidden" name="company_id" value="{{ company.company_id or company.id }}" />
      <input type="hidden" name="id" value="{{ company.id or company.company_id }}" />
    {% endif %}
    <input type="hidden" name="_submit_check" value="1" />
    
    <!-- Primary Company Information -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">{{ _('Primary Company Profile') }}</h3>
      </div>

      <div>
        <label for="company" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Company Name') }} *</label>
        <input type="text" name="company" id="company" value="{{ company.company or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="e.g. Acme Corporation" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="faxnumber" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Fax Number') }}</label>
          <input type="text" name="faxnumber" id="faxnumber" value="{{ company.faxnumber or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 font-mono bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="+1-555-0199" />
        </div>

        <div>
          <label for="email" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Email Address') }}</label>
          <input type="email" name="email" id="email" value="{{ company.email or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="contact@company.com" />
        </div>
      </div>
    </div>

    <!-- Contact Person & Physical Location -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">{{ _('Recipient Contact & Physical Address') }}</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="to_person" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Attention Person') }}</label>
          <input type="text" name="to_person" id="to_person" value="{{ company.to_person or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="John Doe" />
        </div>

        <div>
          <label for="to_voicenumber" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Voice Telephone') }}</label>
          <input type="text" name="to_voicenumber" id="to_voicenumber" value="{{ company.to_voicenumber or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 font-mono bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="+1-555-0100" />
        </div>

        <div class="md:col-span-2">
          <label for="to_address" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Street Address') }}</label>
          <input type="text" name="to_address" id="to_address" value="{{ company.to_address or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="123 Business Boulevard" />
        </div>

        <div>
          <label for="to_city" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('City / Postal Region') }}</label>
          <input type="text" name="to_city" id="to_city" value="{{ company.to_city or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="Metropolis" />
        </div>

        <div>
          <label for="category" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Category Tag') }}</label>
          <select name="category" id="category" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
            <option value="">{{ _('General') }}</option>
            <option value="invoices" {% if company.category == 'invoices' %}selected{% endif %}>{{ _('Invoices & Billing') }}</option>
            <option value="legal" {% if company.category == 'legal' %}selected{% endif %}>{{ _('Legal') }}</option>
          </select>
        </div>
      </div>

      <div>
        <label for="description" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Description / Internal Notes') }}</label>
        <input type="text" name="description" id="description" value="{{ company.description or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="Optional notes regarding this contact" />
      </div>
    </div>

    <!-- Actions (Strict Button Sequence delete -> save) -->
    <div class="pt-4 border-t border-slate-200">
      {% if company and (company.id or company.company_id) %}
        <div class="flex items-center justify-between">
          <button type="submit" name="delete" value="1" class="px-5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition" onclick="return confirm('Are you sure you want to delete this company?');">
            {{ _('Delete') }}
          </button>
          <div class="space-x-3">
            <a href="/addressbook" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">{{ _('Cancel') }}</a>
            <button type="submit" name="save" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">
              {{ _('Save') }}
            </button>
          </div>
        </div>
      {% else %}
        <div class="flex items-center justify-end space-x-3">
          <a href="/addressbook" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">{{ _('Cancel') }}</a>
          <button type="submit" name="save" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">
            {{ _('Save') }}
          </button>
        </div>
      {% endif %}
    </div>

  </form>

</div>
{% endblock %}


