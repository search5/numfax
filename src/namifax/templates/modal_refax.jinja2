<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/50 backdrop-blur-xs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>- NamiFAX - Reply to Fax</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.3.5" type="text/css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 font-sans antialiased text-slate-800">

  <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-200 flex items-center justify-center text-indigo-700 shadow-2xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
          </svg>
        </div>
        <div>
          <h1 class="text-sm font-bold text-slate-900 tracking-tight">{{ _('Reply to Fax') }}</h1>
          <p class="text-[11px] text-slate-500">{{ _('Dispatch quick reply transmission to originating sender') }}</p>
        </div>
      </div>
      <button type="button" onclick="window.close()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Form (Strict W35 Sequence Contract) -->
    <form action="/refax" method="post" class="p-6 space-y-4 text-xs">
      <div>
        <label for="destinations" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Destination Number') }} *</label>
        <textarea name="destinations" id="destinations" rows="2" required class="w-full border border-slate-300 rounded-lg p-3 bg-slate-50/50 text-slate-900 font-mono text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="+1 555 0199">{{ destinations }}</textarea>
      </div>

      <div>
        <label for="regarding" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Regarding (Subject)') }}</label>
        <input type="text" name="regarding" id="regarding" value="{{ regarding }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="RE: Transmitted Fax" />
      </div>

      <div>
        <label for="comments" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Comments') }}</label>
        <textarea name="comments" id="comments" rows="3" class="w-full border border-slate-300 rounded-lg p-3 bg-slate-50/50 text-slate-900 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="Add reply notes or cover page text...">{{ comments }}</textarea>
      </div>

      <input type="hidden" name="fid" value="{{ fid }}" />
      <input type="hidden" name="_submit_check" value="1" />

      <!-- Action Buttons (Strict Sequence: Cancel -> Send) -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2.5">
        <button type="button" onclick="window.close()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold text-xs transition">
          {{ _('Cancel') }}
        </button>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">
          {{ _('Send') }}
        </button>
      </div>
    </form>

  </div>

</body>
</html>

