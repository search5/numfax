{% extends "layout.jinja2" %}

{% block title %}- NamiFAX - Edit Email Contact - Email Book{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-6">
  
  <!-- Header & Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">Email Book - Edit Email Contact</h2>
        <p class="text-xs text-slate-500">Manage contact information and company affiliation in Email Book.</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-2">
      <a href="/emailbook" class="px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold border border-slate-300 shadow-2xs transition">
        &larr; Back to Email Book
      </a>
    </div>
  </div>

  <!-- Form Container (Strict W54 & W67 Sequence Contract) -->
  <form action="/emailbook/edit" method="post" class="space-y-6 text-xs">
    
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Contact Profile Details</h3>
      </div>

      <div>
        <label for="company" class="block font-semibold text-slate-700 text-xs mb-1.5">Company Affiliation</label>
        <input type="text" name="company" id="company" value="{{ contact.company or '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="e.g. Acme Corporation" />
      </div>

      <div>
        <label for="contact_name" class="block font-semibold text-slate-700 text-xs mb-1.5">Contact Name *</label>
        <input type="text" name="contact_name" id="contact_name" value="{{ contact.name or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="John Doe" />
      </div>

      <div>
        <label for="contact_email" class="block font-semibold text-slate-700 text-xs mb-1.5">Email Address *</label>
        <input type="email" name="contact_email" id="contact_email" value="{{ contact.email or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 font-mono text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="user@domain.com" />
      </div>

      <!-- Hidden Identity Keys -->
      <input type="hidden" name="email_id" value="{{ contact.id or 1 }}" />
      <input type="hidden" name="abookemail_id" value="{{ contact.id or 1 }}" />
      <input type="hidden" name="_submit_check" value="1" />
    </div>

    <!-- Actions (Strict W67 Button Sequence: delete -> save) -->
    <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
      <button type="submit" name="delete" value="1" class="px-5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition" onclick="return confirm('Are you sure you want to delete this contact?');">
        Delete
      </button>
      <div class="space-x-3">
        <a href="/emailbook" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">Cancel</a>
        <button type="submit" name="save" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">
          Save
        </button>
      </div>
    </div>

  </form>

</div>
{% endblock %}


