#!/bin/sh
# HylaFAX CoverCmd: makes the cover page for sendfax (used by Send Fax with a cover page).  Copy to $SPOOL/bin/ (usually /var/spool/hylafax/bin).
# NAMIFAX_HOME is where NamiFAX is installed; DATABASE_URL etc. come from /etc/namifax.env.
[ -r /etc/namifax.env ] && . /etc/namifax.env
exec "${NAMIFAX_HOME:-/opt/namifax}/.venv/bin/namifax-faxcover" "$@"
