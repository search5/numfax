#!/bin/sh
# HylaFAX DynamicConfig: called by faxgetty on every ring to accept or reject the call.  Copy to $SPOOL/bin/ (usually /var/spool/hylafax/bin).
# NAMIFAX_HOME is where NamiFAX is installed; DATABASE_URL etc. come from /etc/namifax.env.
[ -r /etc/namifax.env ] && . /etc/namifax.env
exec "${NAMIFAX_HOME:-/opt/namifax}/.venv/bin/namifax-dynconf" "$@"
