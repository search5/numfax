#!/bin/sh
# HylaFAX NotifyCmd: called by faxq when a job is done, blocked, requeued or failed.  Copy to $SPOOL/bin/ (usually /var/spool/hylafax/bin).
# NAMIFAX_HOME is where NamiFAX is installed; DATABASE_URL etc. come from /etc/namifax.env.
[ -r /etc/namifax.env ] && . /etc/namifax.env
exec "${NAMIFAX_HOME:-/opt/namifax}/.venv/bin/namifax-notify" "$@"
